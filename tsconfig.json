{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"types": ["jest", "node", "@testing-library/jest-dom"],
		"isolatedModules": true,
		"jsx": "react-jsx",
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@commands/*": ["./src/commands/*"],
			"@engine/*": ["./src/engine/*"],
			"@i18n/*": ["./src/i18n/*"],
			"@render/*": ["./src/render/*"],
			"@state/*": ["./src/state/*"],
			"@window/*": ["./src/window/*"],
			"@theme": ["./src/theme"],
			"@types": ["./src/types"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		".storybook/**/*.ts",
		"jest.setup.ts"
	],
	"exclude": ["node_modules"]
}
