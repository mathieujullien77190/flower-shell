{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "commonjs",
		"moduleResolution": "node",
		"verbatimModuleSyntax": false,
		"isolatedModules": false,
		"noEmit": false,
		"types": ["jest", "node", "@testing-library/jest-dom"]
	},
	"include": ["src/**/*.test.ts", "src/**/*.test.tsx", "jest.setup.ts"]
}
