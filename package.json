{
	"name": "flower-shell",
	"version": "0.1.0",
	"description": "Terminal retro en React : moteur de commandes, historique, fenetre, rendu ASCII",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19",
		"styled-components": ">=6",
		"zustand": ">=5"
	},
	"dependencies": {
		"react-device-detect": "2.2.3",
		"react-string-replace": "^2.0.1",
		"uniqid": "5.4.0"
	},
	"scripts": {
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build",
		"typecheck": "tsc --noEmit",
		"build": "vite build --config vite.lib.config.ts",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/react-vite": "^10.5.10",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"storybook": "^10.5.10",
		"styled-components": "6.5",
		"typescript": "5.9",
		"vite": "^8.2.2",
		"vite-plugin-dts": "^4.5.4",
		"zustand": "^5.0.15"
	}
}
